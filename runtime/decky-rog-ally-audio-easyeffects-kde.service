[Unit]
Description=EasyEffects KDE tray runtime for ROG Ally Audio
After=pipewire.service pipewire-pulse.service
Wants=pipewire.service pipewire-pulse.service

[Service]
Type=simple
ExecStart=%h/.local/share/decky-rog-ally-audio/easyeffects-kde.sh
ExecStop=-/usr/bin/flatpak kill com.github.wwmm.easyeffects
Restart=always
RestartSec=2
TimeoutStopSec=10

# Deliberately no [Install] section. The session manager owns this service and
# guarantees it never races the Gaming Mode headless instance.
