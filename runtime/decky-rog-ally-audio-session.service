[Unit]
Description=ROG Ally Audio Desktop/Gaming session handoff
After=pipewire.service pipewire-pulse.service
Wants=pipewire.service pipewire-pulse.service

[Service]
Type=simple
ExecStart=%h/.local/share/decky-rog-ally-audio/session_manager.py
Restart=always
RestartSec=1

[Install]
WantedBy=default.target
