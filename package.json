{
  "name": "rog-ally-audio-decky",
  "version": "0.1.11",
  "description": "Decky Loader audio profiles and EasyEffects runtime for ASUS ROG Xbox Ally X",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "python -m pytest -q",
    "package": "python scripts/package.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dragonk/ROGAllyAudio.git"
  },
  "keywords": [
    "decky",
    "steam-os",
    "rog-ally",
    "rog-xbox-ally-x",
    "easyeffects",
    "audio"
  ],
  "author": "Kamil Maciąg",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Dragonk/ROGAllyAudio/issues"
  },
  "homepage": "https://github.com/Dragonk/ROGAllyAudio#readme",
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@decky/ui": "4.11.0",
    "@rollup/rollup-linux-x64-musl": "4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "4.53.3",
    "typescript": "5.6.2"
  },
  "dependencies": {
    "@decky/api": "1.1.3",
    "react-icons": "5.3.0",
    "tslib": "2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
